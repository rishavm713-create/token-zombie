#!/bin/sh
# Run a TZ Python script with a working Python 3: python3 on macOS/Linux; on Windows (Git Bash, which Claude Code
# uses for hooks) the first of `py -3`, python, python3 that really runs (python3 there may be a Store stub). Cached.
if [ "$OS" != "Windows_NT" ]; then exec python3 "$@"; fi
c="${TEMP:-${TMP:-/tmp}}/tz-python"
if [ -s "$c" ]; then read -r p < "$c"; exec $p "$@"; fi
for p in "py -3" python python3; do
  if $p -c "import sys; sys.exit(sys.version_info < (3, 8))" </dev/null >/dev/null 2>&1; then
    printf '%s\n' "$p" > "$c" 2>/dev/null; exec $p "$@"
  fi
done
echo "TOKEN ZOMBIE: Python 3.8+ not found; install it from python.org" >&2
exit 0
