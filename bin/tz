#!/usr/bin/env python3
# tz: one CLI over the token-zombie modules. Shared config/state: ~/.claude/token-zombie/ (config.json, env TZ_<KEY>).
# Old scripts (tz-guard.py, tz-status.py, tz-start.py, tz-compact.py, tz-vet.sh) are unchanged and still work alone.
import os, subprocess, sys
D = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, D)

HELP = """tz <command> [args]
  status [--transcript F] [--rate-limits JSON]   context %, tokens, burn, 5h/7d only if provided, warn state
  forecast                                       burn-rate + limit forecast lines only
  next [add|start|done|pack|checkpoint|measure]  dependency-aware tasks, task pack, gates, per-session token split
  startup [N]                                    what a new chat loads (startup audit)
  optimize [--transcript F]                      duplicate reads / repeated commands in the chat log
  filter [--lines N] < text                      shrink noisy command output
  classify <prompt words>                        task mode + cheapest capable model advice
  stats                                          savings: measured vs estimated, minus tz overhead
  handoff --task T --done D --left L --next N [--test CMD] [--remember FACT]
  task-wrap [--test CMD] [--summary S] [--remember DECISION] [--force]   close task only if test passes; logs DAILY/MASTER
  checkpoint                                     refresh git snapshot of the active task (no commands run)
  import --from CHAT.jsonl [--task T]            handoff from a crashed chat log (chain id kept)
  handoff save|status|verify|resume|ctx --pct N   durable docs/HANDOFF.md etc, integrity score, context-% checkpoints (70/80/90/95/98, 99 = emergency)
  learn [--apply] [--target F]                   mine repeated tool failures from chat logs; dry run unless --apply
  split "task A" "task B"                       one session per task: model pick, worktree cmd, locks, build-first rule
  costly [--no-write]                            biggest tool outputs in recent chats; hot kinds get a warning next time
  agent "<task>" [--test CMD] [--worktree] run the tz code pipeline for real (plan, build, test, debug), budget + ledger
  map [dir]                                      compact repo map (file -> defs), Aider-style; read this instead of many files
  xcheck [--json FILE]                           cross-check token totals against ccusage (if installed)
  noise [--apply]                                proposed Read-deny rules for node_modules/lockfiles/build output (dry run)
  similar [QUERY]                                read-only GitHub search for similar tools (ideas; vet before use)
  code [TASK]                                    coding pipeline: plan, build, debug, test, review, simplify, ship with model + best installed skill per phase
  lock acquire|release|status NAME [--ttl S]     lock for a shared resource (live test/device/port)
  hsize [DIR]                                    handoff size check (daily <=30 lines, top block <=15, weekly merge)
  resume [--run-test]                            verify handoff vs git/tests, print next action
  replay [transcript]                            costliest steps (input-eq) + repeated tool calls
  skills [prompt words]                          skills loaded/parked; relevance advice
  skills find Q | preview DIR | stage DIR --yes | unstage N | usage | updates   curated catalog search, safety preview of a local clone, staged reversible install
  capabilities                                   skills/plugins/MCP inventory, overlaps
  ondemand [on|off NAME|end|log|rollback]        optional MCP/plugin/skill on for a task, off at chat end
  security <dir>                                 GREEN/YELLOW/RED scan of a skill/plugin/repo
  audit                                          security grade of every installed skill
  bench [--chat-tokens N] [--json]               before/after on a synthetic project: MEASURED / EST / UNKNOWN, net of tz overhead
  instructions                                   size + duplicates of CLAUDE.md files loaded every chat
  profile <prompt> [--yes]                       which parked skill packs this task needs; --yes runs your skillpack
  mode [off|lite|full|ultra]                     show or set the mode profile (backs up config.json)
  config                                         effective settings and where each comes from
  report                                         status + optimize + stats + capabilities in one view
  sup start|tick|status|next-session|task      supervisor: usage level -> auto checkpoint -> status bus (status.json)
  route <prompt> [--model M] | --write [FILE] [--yes]   model advice + /model line; --write adds a model-per-task rules block to CLAUDE.md (dry run without --yes)
  adapters [--rules NAME [--out F]]             supported agents + honest capabilities, rules file generation
  reg [list|add <localdir>|show <name>]         local GitHub-repo registry (no network)
  dash --out F | --serve                        HTML dashboard (127.0.0.1 only)
  companion [--port N]                          local status server with token auth (native overlay not built)
  mascot                                        zombie state line
  overlay build|run                             native always-on-top status window (macOS, swiftc from Command Line Tools)
  bench quality TRIALS.json                         tokens per PASSED task, control vs treatment (needs 5+5 trials to count as proof)
  pr [--base B]                                  commit message + PR body from the real diff (read-only; never commits or pushes)
  progress                                       project completion % from task files
  standards [dir]                                detected coding conventions (indent, quotes, test/lint tools)
  tokens [--days N] [--json]                     every token in every chat log by model and day, per category (MEASURED)
  reuse [REPO..]                                 licence audit: REUSE (MIT/Apache, credit) | CHECK | STUDY-only (no licence)
  gaps [dir]                                     stubs, TODOs, unresolved local imports
  missing [dir]                                  features promised in README/docs but not found in code
  contract [dir]                                 frontend fetch calls with no backend route
  api [dir] [--openapi]                          route list or OpenAPI skeleton
  dbschema [dir]                                 tables, columns, foreign keys without index
  coord post|list|claim|done                     shared note board between sessions
  safe "CMD"                                     block destructive shell commands (reset --hard, rm -r /, force push)
  sym NAME                                       where NAME is defined (file:line) + files that use it (impact)
  exists WORDS..                                 existing functions/classes whose names match: reuse before building
  impact FILE|SYMBOL                             what references it: files and tests that may break
  diffcheck [--files a,b]                        diff vs task scope: strays, debug leftovers, huge diffs
  scaffold "IDEA" [--dir D] [--fields a,b]       working SaaS skeleton from templates, 0 tokens, stdlib only
  run "TASK" [--go] [--test CMD]                 one front door: understand to remember, optimized stages
  gate [--test CMD] [--build CMD] [--files a,b]   independent verify of a change: diff, ownership, safe, secrets, tests; status ladder
  worker detect|list|default|add|test|run|rm             provider-independent workers: claude, codex, gemini, aider, opencode, local HTTP model
  hw                                             this machine's memory and which local model size fits (estimate)
  stack idea|design|web|off                      turn on the skill packs an idea-to-product build needs
  features [--md]                                the 69-feature board: DONE / PARTIAL / MISSING, new ones highlighted
  bench harbor [--dataset D] [--n N] [--run]     Harbor/Terminal-Bench control vs treatment commands (prints; --run executes)
  bench results [dir]                           A/B evidence into view
  bench replay [--days N] [--root DIR] [--json]  zero-cost proof: replays your real chat logs offline, net saving after TZ overhead
  attr [LOG] [--json]                           per MCP server / subagent type / main: calls, tokens, $ (MEASURED tok, EST $)
  price [MODEL] [--json]                        one pricing table (EST list price; override ~/.claude/token-zombie/prices.json)
  policy show|check EVENT.json|init             advice-only rules: read/bash caps, dup reads, churn, context %, gates
  adapters --usage codex [--days N] [--json]    Codex CLI usage from ~/.codex/sessions (MEASURED)
  reconcile | vault-find WORDS | overlap SESSION_DIR | skills-outcome [DIR]   savings check, task retrieval, agent file clashes, skill vs rework
  conflicts FILE...                                  contradictory always/never rules across instruction files
  rework [LOG] [--json]                              repeat/retry/loop counts from a chat log (MEASURED counts)
  hooks bench|live                              hook wall-time baseline (temp HOME) / live per-event hook time + injected chars
  live [show|skills|agents]                     this session: skill states, agent lifecycle, dedupe advices (MEASURED from hooks)
  preflight [--evidence D] [--validate D] [--smoke --yes]  A/B readiness: offline checks; validate a finished run; paid smoke run
  ledger                                         one SQLite ledger: event counts; --alerts (evidence/intervention/outcome), --vault [--tool T] [--file F]
  compress FILE.py                               AST skeleton (validated, fail open, original in tz recall)
  shadow                                         trim rule: cuts made/would be made, originals re-read (set out_trim "shadow" to canary)
  live roi [--session S]                         per-agent cost vs outcome, advice flags (small/empty/failed/duplicate)
  systems [--json] [--session S]                 8 systems: happening / did / impact / evidence / status (state files only), writes systems.json
  export [CHAT.jsonl] [--out F] | --otlp F [--preview]   usage totals as a JSON line, or OTLP/JSON metrics to a local file (no network, no prompts)
  workflow [plan|build|test|review]               checklist with checkpoints (advice only)
  worktree TASK                                   prints the git worktree command that isolates one task/agent
  worktree add TASK [--files a,b] [--base REF] | claim TASK FILE.. | remove TASK [--force] | list   real worktree per task + file ownership (overlap refused)
  find WORDS..                                   search handoff notes (all words match) for task-level recall
  doctor                                         one-screen health check (ledger, savings records, hooks, rules)
  recall <id> [--grep P] [--lines A-B]          full text of a tool output TZ trimmed (ids are in the trim note)
  state [--cwd D]                               compact authoritative handoffs/STATE.md (master, current work, session handoff)
  expensive [--transcript F] [--session S] [--force]  real cost signals -> verified checkpoint + fresh-chat startup line
  waste-audit [--transcript F]                  duplicated handoff docs, repeated reads, long pasted briefs
  help"""


def run_script(name, args):
    return subprocess.call([sys.executable, os.path.join(D, name), *args])


def config():
    from tzlib import DEFAULTS, cfg, _conf
    for k in DEFAULTS:
        src = 'env' if os.environ.get(f'TZ_{k.upper()}') else 'config.json' if _conf.get(k) else 'default'
        print(f'{k} = {cfg(k)} ({src})')
    return 0


def main(argv):
    if not argv or argv[0] in ('help', '-h', '--help'):
        print(HELP)
        return 0
    c, rest = argv[0], argv[1:]
    try:
        if c in ('status', 'forecast'):
            import tzusage
            return tzusage.main([c, *rest])
        if c in ('optimize', 'stats', 'filter', 'classify'):
            import tzopt
            return tzopt.main([c, *rest])
        if c == 'handoff' and rest[:1] in (['save'], ['status'], ['verify'], ['resume'], ['ctx']):
            import tzintegrity
            return tzintegrity.main([rest[0], *rest[1:]])
        if c in ('handoff', 'resume', 'task-wrap', 'checkpoint', 'import'):
            import tzhandoff
            return tzhandoff.main([c, *rest])
        if c == 'skills' and rest[:1] in (['find'], ['preview'], ['stage'], ['unstage'], ['usage'], ['updates']):
            import tzfinder
            return tzfinder.main(rest)
        if c in ('skills', 'capabilities', 'security', 'audit', 'instructions', 'profile'):
            import tzcap
            return tzcap.main([c, *rest])
        mods = {'learn': 'tzlearn', 'sup': 'tzsup', 'route': 'tzroute', 'adapters': 'tzadapters', 'reg': 'tzreg', 'dash': 'tzdash', 'companion': 'tzcompanion', 'mascot': 'tzmascot', 'hooks': 'tzhooks', 'live': 'tzlive', 'ledger': 'tzdb', 'compress': 'tzcompress', 'rework': 'tzrework', 'attr': 'tzattr', 'price': 'tzprice', 'policy': 'tzpolicy', 'reconcile': 'tzmore', 'export': 'tzmore', 'workflow': 'tzmore', 'worktree': 'tzmore', 'find': 'tzmore', 'doctor': 'tzmore', 'split': 'tzsplit', 'code': 'tzsplit', 'similar': 'tzsimilar', 'costly': 'tzcost', 'map': 'tzmap', 'sym': 'tzmap', 'exists': 'tzmap', 'agent': 'tzagent', 'xcheck': 'tzmap', 'noise': 'tzcost', 'lock': 'tzsplit', 'hsize': 'tzsplit', 'vault-find': 'tzmore', 'overlap': 'tzmore', 'skills-outcome': 'tzmore', 'conflicts': 'tzattr', 'preflight': 'tzpreflight', 'recall': 'tzout', 'next': 'tznext', 'state': 'tzcont', 'replay': 'tzcont', 'expensive': 'tzcont', 'waste-audit': 'tzcont', 'ondemand': 'tzondemand', 'systems': 'tzsystems', 'shadow': 'tzout'}
        if c in mods:
            return __import__(mods[c]).main(([c] if mods[c] in ('tzcont', 'tzout', 'tzattr', 'tzmore', 'tzsplit', 'tzcost', 'tzmap', 'tzagent') else []) + rest)
        if c == 'overlay':  # build/run the native always-on-top window (Command Line Tools swiftc; installs nothing)
            ov = os.path.join(D, '..', 'overlay')
            if rest[:1] == ['build']:
                return subprocess.call(['bash', os.path.join(ov, 'build.sh')])
            exe = os.path.join(ov, 'build', 'TZOverlay')
            if rest[:1] == ['run'] and os.path.exists(exe):
                subprocess.Popen([exe], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
                print('overlay started (kill it with: pkill TZOverlay)')
                return 0
            print('usage: tz overlay build | run   (run needs a prior build)', file=sys.stderr)
            return 2
        mods2 = {'pr': 'tzpr', 'progress': 'tzprogress', 'standards': 'tzstandards', 'features': 'tzfeatures', 'tokens': 'tztokens'}
        if c in ('reuse', 'gaps', 'missing', 'contract', 'api', 'dbschema', 'coord', 'stack'):
            import tzbuild
            return tzbuild.main([c] + rest)
        if c == 'scaffold':
            import tzscaffold
            return tzscaffold.main(rest)
        if c == 'gate':
            import tzgate
            return tzgate.main(rest)
        if c in ('worker', 'hw'):
            import tzworkers
            return tzworkers.main([c] + rest)
        if c in ('safe', 'impact', 'diffcheck', 'run'):
            import tzops
            return tzops.main([c] + rest)
        if c in mods2:
            import importlib
            return importlib.import_module(mods2[c]).main(rest)
        if c == 'bench' and rest[:1] == ['harbor']:
            import tzharbor
            return tzharbor.main(rest[1:])
        if c == 'bench' and rest[:1] == ['replay']:
            import tzreplay
            return tzreplay.main(rest[1:])
        if c == 'bench':
            import tzbench
            return tzbench.main(rest)
        if c == 'startup':
            return run_script('tz-status.py', ['--startup', *rest])
        if c == 'mode':
            import tzmode
            return tzmode.main(rest)
        if c == 'config':
            return config()
        if c == 'report':
            for title, cmd in (('STATUS', ['status']), ('OPTIMIZE', ['optimize']), ('SAVINGS', ['stats']), ('CAPABILITIES', ['capabilities'])):
                print(f'== {title}')
                main(cmd + rest if cmd == ['status'] else cmd)
            return 0
    except SystemExit as e:
        return e.code if isinstance(e.code, int) else 2
    except Exception as e:  # one clear line, no traceback
        print(f'tz {c}: {type(e).__name__}: {e}', file=sys.stderr)
        return 1
    print(f'tz: unknown command "{c}". Run `tz help`.', file=sys.stderr)
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
